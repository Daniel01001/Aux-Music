{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aux",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "port": 3000
    },
    {
      "name": "aux-google",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js"],
      "env": { "PORT": "3001", "GOOGLE_CLIENT_ID": "test-client.apps.googleusercontent.com", "DATA_FILE": "data-google-test.json" },
      "port": 3001
    }
  ]
}
