{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aux-music",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "music.africanspring.co.za", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws", "/.well-known/*"]
  },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "aux", "database_id": "418a533a-e741-45c8-911a-7158947d793c", "migrations_dir": "migrations" }
  ],
  // Public values only. The OAuth client ID is visible to every browser anyway.
  "vars": {
    "GOOGLE_CLIENT_ID": "632209402259-76jbita286ahuhf4257c2j4vpg12pglf.apps.googleusercontent.com",
    // Web push: the public half of the VAPID key pair. The private half is the VAPID_PRIVATE_KEY secret.
    "VAPID_PUBLIC_KEY": "BBYUjm7ZECymhuCYinske5Bl8706CFXYhc4S1imivN8aQxbvkW3b4cjWxJN_Wx988LMssOi3LCUAARQRPWkSpGY"
  }
  // Set with `wrangler secret put` or in the dashboard, not here:
  //   YT_API_KEY, JAMENDO_CLIENT_ID, VAPID_PRIVATE_KEY (secrets), ANDROID_PACKAGE, ANDROID_SHA256
}
